{
  "name": "sketchware-desktop",
  "productName": "Sketchware Desktop",
  "version": "0.1.0-beta.1",
  "description": "Desktop edition of Sketchware Pro: build Android apps with blocks",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "electron": "electron .",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.idiken.sketchware-desktop",
    "productName": "Sketchware Desktop",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "public/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "SketchwareDesktop-${version}-win-x64.exe"
    }
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/legacy-modes": "^6.4.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@fontsource/roboto": "^5.1.0",
    "codemirror": "^6.0.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.8.10",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true
  }
}
